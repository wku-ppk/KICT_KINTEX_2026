model new
model restore '[1]_.sav'

; Generate structures in Concourse and EXITS

zone gridpoint initialize displacement-x 0.0
zone gridpoint initialize displacement-y 0.0
zone gridpoint initialize displacement-z 0.0
zone gridpoint initialize displacement-z 0.0

zone gridpoint initialize velocity-x 0.0
zone gridpoint initialize velocity-y 0.0
zone gridpoint initialize velocity-z 0.0
; Hide soil layers to preevnt intervention while selecting structural faces
zone hide true  group "1=ZG_004" and "Layer=Fill" only by zone
zone hide true  group "1=ZG_003" and "Layer=AlluvialSand" only by zone
zone hide true  group "1=ZG_006" and "Layer=AlluvialClay" and "Vent5Wall=AlluvialClay" only by zone
zone hide true  group "1=ZG_008" and "Layer=AlluvialClay" only by zone
zone face hide true  group "Default=IF_003_005" only by zone-face
zone face hide true  group "Default=EF_001" only by zone-face
zone face hide true  group "Default=IF_003_003" only by zone-face
zone face hide true  group "Default=IF_002_003" only by zone-face
zone face hide true  group "Default=EF_002" only by zone-face
zone face hide true  group "Default=EF_005" only by zone-face
zone face hide true  group "Default=EF_003" only by zone-face
zone face hide true  group "Default=EF_007" only by zone-face
zone face hide true  group "Default=EF_009" only by zone-face
;
zone face hide true  group "Default=IF_003_070" only by zone-face
zone face hide true  group "Default=IF_003_058" only by zone-face
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Concourse
zone face select  skin begin (29.8223,-263.585,138.303) direction (-0.455615,0.739463,-0.49559) break-angle 0
zone face group "TopSlab" slot "Concourse" internal range selected

zone face select off internal use-hidden-zones

zone face hide true  group "Default=IF_006_036" only by zone-face
zone face hide true  group "Default=IF_003_089" only by zone-face
zone face hide true  group "Default=IF_003_037" only by zone-face
