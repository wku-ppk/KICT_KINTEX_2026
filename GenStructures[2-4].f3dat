model new
model restore '[2-3]_.sav'

; Generate structures in Vent
; set environments
zone hide true  group "1=ZG_004" and "Layer=Fill" only by zone
zone hide true  group "1=ZG_006" and "Layer=AlluvialClay" and "Vent5Wall=AlluvialClay" only by zone
zone hide true  group "1=ZG_003" and "Layer=AlluvialSand" only by zone
