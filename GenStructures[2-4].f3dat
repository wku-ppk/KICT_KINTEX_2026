;;;;;;;;;;
; ConnToMainShaftShell

zone face hide true  group "Default=IF_018_033" only by zone-face
zone face select  skin begin (58.3245,-249.635,69.8162) direction (-0.764897,0.636682,-0.0978181) break-angle 45
zone face group "Upper" slot "ConnToMainShaftShell" internal range selected
zone face select off internal use-hidden-zones

zone face select  skin begin (21.7544,-228.186,48.6469) direction (-0.229846,0.838905,0.493365) break-angle 10
zone face group "Lower" slot "ConnToMainShaftShell" internal range selected
zone face select off internal use-hidden-zones

;; generate shell
zone face hide off internal use-hidden-zones

struct shell create by-zone-face element-type dkt-cst ID 701 internal range group "Platform=End"
struct shell create by-zone-face element-type dkt-cst ID 702 internal range group "Platform=Invert"
struct shell create by-zone-face element-type dkt-cst ID 703 internal range group "Platform=Upper"

struct shell create by-zone-face element-type dkt-cst ID 801 internal range group "MainTunnel=Invert"
struct shell create by-zone-face element-type dkt-cst ID 802 internal range group "MainTunnel=Upper"

struct shell create by-zone-face element-type dkt-cst ID 911 internal range group "Vent5ConnShell=Upper"
struct shell create by-zone-face element-type dkt-cst ID 912 internal range group "Vent5ConnShell=MidSlab"
struct shell create by-zone-face element-type dkt-cst ID 913 internal range group "Vent5ConnShell=BaseSlab"

struct shell create by-zone-face element-type dkt-cst ID 921 internal range group "Vent6ConnShell=Upper"
struct shell create by-zone-face element-type dkt-cst ID 922 internal range group "Vent6ConnShell=BaseSlab"
struct shell create by-zone-face element-type dkt-cst ID 923 internal range group "Vent6ConnShell=MidSlab"

struct shell create by-zone-face element-type dkt-cst ID 931 internal range group "ConnToMainShaftShell=Upper"
struct shell create by-zone-face element-type dkt-cst ID 932 internal range group "ConnToMainShaftShell=Lower"

; delete zone
zone hide off range use-hidden
zone delete range group "Structure=HR" 
zone delete range group "Structure=SR" 

; gen Concourse Column
fish define genColumn(cor_x, cor_y, cor_zb)
  sPt_top = struct.node.near(cor_x, cor_y, 102.389) ; get nearest shell node corresponds to the input coordinates
  sPt_bot = struct.node.near(cor_x, cor_y, cor_zb) ; 

  ; we will construct column using node ID of top and bottom slab
  ; get pointer of shell node to be connected with column and translate into node id
  ; push node id to glabal variable to be used for command that genearte column

  global nodeIDtop = struct.node.id.component(sPt_top) ; get top slab node id
  global nodeIDbot = struct.node.id.component(sPt_bot) ; get bot slab node id  

  global beamNodePosTop = struct.node.pos(sPt_top)
  global beamNodePosBot = struct.node.pos(sPt_bot)


  oo = io.out('      ')
  oo = io.out('Shell Node IDs')
  oo = io.out(nodeIDtop)
  oo = io.out(nodeIDbot)
  oo = io.out('      ')

  oo = io.out('Shell Node Pos')
  oo = io.out(beamNodePosTop)
  oo = io.out(beamNodePosBot)
  oo = io.out('      ') 
  
  

  command
      struct beam create by-line @beamNodePosTop @beamNodePosBot id 3000 group 'A'
;      struct node join       
  end_command

  global beamEndnode   = struct.node.maxid ; top
  global beamEndnode_1 = struct.node.maxid - 1 ; bot

  oo = io.out('      ')
  oo = io.out('Beam Node IDs')
  oo = io.out(beamEndnode)
  oo = io.out(beamEndnode_1)
  oo = io.out('      ')
end

@genColumn(-21.9438,-213.821,93.8888)
@genColumn(-21.9438,-200.821,93.8888)

@genColumn(-14.4438,-213.821,93.8888)
@genColumn(-14.4438,-200.821,93.8888)

@genColumn(-6.94382,-213.821,93.8888)
@genColumn(-6.94382,-200.821,93.8888)

@genColumn(0.556176,-213.821,93.8888)
@genColumn(0.556176,-200.821,93.8888)

@genColumn(8.05618,-213.821,93.8888)
@genColumn(8.05618,-200.821,93.8888)
