model new
model restore '[2-3]_.sav'

; Hide soil layers to prevent intervention while selecting structural faces
; Platform

zone face select  skin begin (88.5179,-368.1,146.103) direction (-0.662157,0.466451,-0.586491) break-angle 20
zone face select  skin begin (13.4438,-5.59294,116.427) direction (-0.184757,-0.897005,-0.401556) break-angle 20
zone face group "Platform=End" internal range selected
zone face hide internal range selected
zone face select off internal use-hidden-zones

zone face hide true  group "Default=IF_016_079" or "Default=IF_016_042"
zone face select  skin begin (4.78401,-329.464,87.7748) direction (-0.14165,0.919153,-0.367549) break-angle 20
zone face group "Platform=Upper" internal range selected
zone face select off internal use-hidden-zones

zone face select  skin begin (-4.56182,-363.934,-47.4282) direction (-0.00621496,0.701415,0.712726) break-angle 20
zone face group "Platform=Invert" internal range selected
zone face select off internal use-hidden-zones
struct shell create by-zone-face element-type dkt-cst ID 701 internal range group "Platform=End" use-hidden
struct shell create by-zone-face element-type dkt-cst ID 702 internal range group "Platform=Invert" use-hidden
struct shell create by-zone-face element-type dkt-cst ID 703 internal range group "Platform=Upper" use-hidden

