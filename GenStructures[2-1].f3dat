zone face group "SideWall2" slot "Concourse" internal range selected
zone face select off internal use-hidden-zones

zone hide true  group "1=ZG_003" and "Layer=WS" only by zone
zone hide true  group "1=ZG_005" and "Layer=WR" only by zone
zone hide true  group "1=ZG_002" and "Layer=SR" only by zone
zone hide true  group "1=ZG_001" and "Layer=HR" only by zone
zone hide true  group "1=ZG_105" and "Structure=AlluvialSand" only by zone
zone hide true  group "1=ZG_089" and "Structure=AlluvialSand" only by zone
zone hide true  group "1=ZG_037" and "Structure=AlluvialSand" only by zone
zone hide true  group "1=ZG_039" and "Structure=AlluvialSand" only by zone
zone face select  skin begin (-64.1959,-216.246,35.2795) direction (0.613333,0.083987,0.785347) break-angle 0
zone face group "BaseSlab" slot "Concourse" internal range selected

;generate shell in concourse
struct shell create by-zone-face element-type dkt-cst ID 100 internal range group "TopSlab" slot "Concourse"
struct shell create by-zone-face element-type dkt-cst ID 101 internal range group "SideWall1" slot "Concourse"
struct shell create by-zone-face element-type dkt-cst ID 102 internal range group "SideWall2" slot "Concourse"
struct shell create by-zone-face element-type dkt-cst ID 103 internal range group "BaseSlab" slot "Concourse"

zone delete range use-hidden group "AlluvialClay" slot "Concourse"
zone delete range use-hidden group "AlluvialSand" slot "Concourse"


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
