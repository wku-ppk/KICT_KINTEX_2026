;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;set Concourse to MainShaft
zone face hide true  group "Default=IF_054_070" only by zone-face
zone face hide true  group "Default=IF_054_058" only by zone-face
zone face hide true  group "Default=IF_003_049" only by zone-face

zone face select  skin begin (-5.08188,-240.376,110.032) direction (0.642711,0.683677,-0.345701) break-angle 45
zone face select  skin begin (-5.14719,-240.325,110.062) direction (0.416918,0.88091,-0.224001) break-angle 45
zone face group   "SideWall" slot "ConnToMainShaft" internal range selected
zone face select off internal use-hidden-zones
