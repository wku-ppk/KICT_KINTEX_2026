model new
model rest '[3]_.sav'

zone gridpoint initialize displacement-x 0.0
zone gridpoint initialize displacement-y 0.0
zone gridpoint initialize displacement-z 0.0

zone gridpoint initialize velocity-x 0.0
zone gridpoint initialize velocity-y 0.0
zone gridpoint initialize velocity-z 0.0

program call 'D-Prep.f3fis'

; set dynamic non-linearity
zone dynamic damping hysteretic default -3.32872 0.8056 range group 'Layer=Fill' ; Seed & Idriss Mean Value
zone dynamic damping hysteretic default -3.24552 1.4547 range group "Layer=AlluvialClay" ; Vucetic

zone dynamic damping hysteretic default -3.32872 0.8056 range group "Layer=AlluvialSand" ; Seed & Idriss Mean Value
zone dynamic damping hysteretic sigmoidal-3 1.026775 -0.59759 -1.12502 range group 'Layer=WS' ; Check, from Prof. Choo, KSGE 2001. 10, Vol. 17, No. 5, unit Pa
zone dynamic damping hysteretic sigmoidal-3 1.026775 -0.59759 -1.12502 range group 'Layer=WR' ; Check, from Prof. Choo, KSGE 2001. 10, Vol. 17, No. 5, unit Pa

; Leave softrock and Hard rock linear elastic

model mechanical active on
model dynamic active off
model largestrain off

; setup equilibrium

model solve 

;--- initialize displacement
zone gridpoint initialize displacement-x 0.0
zone gridpoint initialize displacement-y 0.0
zone gridpoint initialize displacement-z 0.0
structure node initialize displacement (0.0, 0.0, 0.0)
;---

;--- Dynamic Analysis Setting
model largestrain on
model mechanical active on
model dynamic active on

;zone dynamic damping rayleigh 0.01 2.0 ; mass stiffness
;zone dynamic damping combined 0.03141592 ; 1% damping for zone
;structure dynamic damping rayleigh 0.01 2.0 ; mass stiffness
;structure dynamic damping combined-local 0.03141592 ; 1% damping for structures
;zone dynamic damping maxwell 0.0385 0.5 0.0335 3.5 0.052 25.0
;structure dynamic damping maxwell 0.0385 0.5 0.0335 3.5 0.052 25.0

zone dynamic damping combined 0.0628 ; 2% damping for zone (soil)
structure dynamic damping combined-local 0.1578 ; 5% damping for structures

;zone dynamic damping maxwell 0.016 0.5 0.012 3.5 0.018 25
;structure dynamic damping maxwell 0.016 0.5 0.012 3.5 0.018 25

;--- Read input motion
table '100' import 'GyeongJuMKL_EW_FLAC.ACC' ;input motion, Unit in (m/s^2), GyeongJu MKL EW
table '110' import 'GyeongJuMKL_NS_FLAC.ACC' ;input motion, Unit in (m/s^2), GyeongJu MKL NS

@G_cor(100, 2.225) ; maintain unit m/s^2 and get dt_
@G_cor(110, 2.225) ; maintain unit m/s^2 and get dt_
;@G_cor(100, 10.0) ; maintain unit m/s^2 and get dt_
@integrate(100, 200) ; velocity history will be stored to the table 200
@integrate(110, 210) ; velocity history will be stored to the table 210
@integrate(200, 300) ; Displacement history will be stored to the table 300
@integrate(210, 310) ; Displacement history will be stored to the table 300

fish define findTableMax(tableNo)
   tableSize = table.size(tableNo)
   local valMax = 0.0
   local indexMax = 0
   loop local i (1, tableSize)
     if math.abs(table.y(tableNo, i)) > valMax then
        valMax = table.y(tableNo, i)
        indexMax = i     
     endif
   endloop
   oo = io.out(indexMax)
   oo = io.out(valMax)
   return indexMax
end
[global accMaxIdx = findTableMax(100)]
[global velMaxIdx = findTableMax(200)]
[global disMaxIdx = findTableMax(300)]

def sortThreeValues(val1, val2, val3)
    local sorted = list.create(3, 0.0)
    if val1 <= val2
        if val1 <= val3
            sorted(1) = val1
            if val2 <= val3
                sorted(2) = val2
                sorted(3) = val3
            else
                sorted(2) = val3
                sorted(3) = val2
            endif
        else
            sorted(1) = val3
            sorted(2) = val1
            sorted(3) = val2
        endif
    else
        if val2 <= val3
            sorted(1) = val2
            if val1 <= val3
                sorted(2) = val1
                sorted(3) = val3
            else
                sorted(2) = val3
                sorted(3) = val1
            endif
        else
            sorted(1) = val3
            sorted(2) = val2
            sorted(3) = val1
        endif
    endif
    global goVia1 = table.x(100,sorted(1))
    global goVia2 = table.x(100,sorted(2))
    global goVia3 = table.x(100,sorted(3))
end
[sortThreeValues(accMaxIdx, velMaxIdx, disMaxIdx)]

;--- apply boundary conditions
zone face apply quiet range position-z 40.0

[global density_of_rock = 2300, vs_of_rock = 1500] ; unit in kg, m, s
[global constant = density_of_rock * vs_of_rock]
[global constantV = density_of_rock * vs_of_rock * 1/3]
;[global constant = 2 * density_of_rock * vs_of_rock]


zone face apply stress-xz @constant table '200' range position-z 40.0
zone face apply stress-yz @constant table '210' range position-z 40.0
zone face apply stress-zz @constantV table '200' range position-z 40.0
;zone face apply stress-zz 0.0 table '200' range position-z 40.0
zone dynamic free-field on


;;; history set



call "SetHistories.fis"


;;; history set




model save '[4]_.sav'